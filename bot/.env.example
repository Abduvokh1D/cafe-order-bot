# Shu faylni nusxalab, nomini .env qiling va qiymatlarni to'ldiring.
# .env git'ga tushmaydi — haqiqiy tokenni faqat o'sha yerga yozing.

# @BotFather bergan token. Bot ishga tushganda uni bazaga ham yozadi:
# Mini App imzosi va xodimlarga xabar shu token bilan ishlaydi.
BOT_TOKEN=

# Mini App manzili. Telegram faqat https:// manzilni ochadi,
# shuning uchun ishlab chiqishda tunnel manzili yoziladi.
WEBAPP_URL=https://

# Shu bot xizmat qiladigan kafe (bazadagi cafes.slug)
CAFE_SLUG=sinov-kafe

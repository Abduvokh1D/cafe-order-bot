# Serverda shu faylni nusxalab, nomini .env qiling va qiymatlarni to'ldiring.
# .env git'ga tushmaydi. Qo'llanma: DEPLOY.md.

# Sayt manzili, https:// siz. DNS shu server IP manziliga qarab turishi kerak
DOMAIN=

# Parolda faqat harf va raqam ishlating, u baza manzili ichiga ham yoziladi.
# Yaratish: openssl rand -hex 32
POSTGRES_PASSWORD=

# @BotFather bergan token
BOT_TOKEN=

# Shu bot xizmat qiladigan kafe (npm run db:create-cafe bilan yaratiladi)
CAFE_SLUG=

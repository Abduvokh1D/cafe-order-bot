{
  "name": "cafe-order-bot",
  "private": true,
  "workspaces": [
    "web",
    "bot",
    "db"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:bot": "npm run dev -w bot",
    "db:up": "docker compose up -d --wait",
    "db:generate": "npm run generate -w @cafe/db",
    "db:migrate": "npm run migrate -w @cafe/db",
    "db:seed": "npm run seed -w @cafe/db",
    "db:studio": "npm run studio -w @cafe/db",
    "db:create-admin": "npm run create-admin -w @cafe/db",
    "db:create-cafe": "npm run create-cafe -w @cafe/db"
  }
}
